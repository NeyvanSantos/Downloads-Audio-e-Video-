# Environment Configuration
NODE_ENV=development
PORT=3001

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=video_downloader
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# yt-dlp/ffmpeg paths (optional, defaults to global install)
YT_DLP_PATH=
FFMPEG_PATH=
# Optional: explicitly supplied Netscape cookie file, used only for YouTube.
YT_DLP_COOKIES_FILE=

# Security
CORS_ORIGIN=http://localhost:3000
